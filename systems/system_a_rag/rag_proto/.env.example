# 참가자 LLM API 키 템플릿. 이 파일을 .env 로 복사한 뒤 값을 채운다:
#     cp .env.example .env
# .env 는 .gitignore 대상이다 — 절대 커밋하지 말 것. 키를 채팅·문서에 붙여넣지 말 것.
# 변수 이름은 configs/participants.yaml 의 api_key_env 와 같아야 한다.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=

# OPENAI_BASE_URL / ANTHROPIC_BASE_URL 은 넣지 않는다.
# 본실험 러너는 이 변수를 읽지 않지만(participants.yaml 참고), 다른 스크립트가
# 이 값을 따라 개발용 테스트 게이트웨이로 호출하게 될 수 있다.
